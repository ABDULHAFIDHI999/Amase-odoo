<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Form view: header buttons, approver field & approval info
    ============================================================ -->
    <record id="view_sale_order_form_approval" model="ir.ui.view">
        <field name="name">sale.order.form.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- ── Draft-state Confirm button ─────────────────────────
                 Replace it entirely:
                 • Approval ON + non-approver  → "Submit for Approval"
                 • Approval ON + is_approver   → "Submit for Approval" too
                   (approvers also go through Approve, not Confirm)
                 • Approval OFF                → normal "Confirm"
            ──────────────────────────────────────────────────────── -->
            <xpath expr="//button[@name='action_confirm' and not(@id)]" position="replace">
                <!-- Approval enabled → Submit for Approval (everyone) -->
                <button
                    string="Submit for Approval"
                    name="action_submit_for_approval"
                    type="object"
                    class="btn-primary"
                    data-hotkey="q"
                    invisible="state != 'draft' or not require_approval"/>
                <!-- Approval disabled → standard Confirm -->
                <button
                    string="Confirm"
                    name="action_confirm"
                    type="object"
                    context="{'validate_analytic': True}"
                    data-hotkey="q"
                    invisible="state != 'draft' or require_approval"/>
            </xpath>

            <!-- ── Sent-state Confirm button (has id="action_confirm") -->
            <xpath expr="//button[@id='action_confirm']" position="replace">
                <!-- Approval enabled → Submit for Approval (everyone) -->
                <button
                    string="Submit for Approval"
                    name="action_submit_for_approval"
                    type="object"
                    class="btn-primary"
                    data-hotkey="q"
                    invisible="state != 'sent' or not require_approval"/>
                <!-- Approval disabled → standard Confirm -->
                <button
                    string="Confirm"
                    id="action_confirm"
                    name="action_confirm"
                    type="object"
                    context="{'validate_analytic': True}"
                    class="btn-primary"
                    data-hotkey="q"
                    invisible="state != 'sent' or require_approval"/>
            </xpath>

            <!-- ── Approve / Refuse buttons ───────────────────────────
                 Visible only to approvers (is_approver) when pending.
                 No groups= so the admin is never blocked.
            ──────────────────────────────────────────────────────── -->
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button
                    string="Approve"
                    name="action_approve"
                    type="object"
                    class="btn-success"
                    invisible="approval_state != 'pending' or not is_approver"/>
                <button
                    string="Refuse"
                    name="action_refuse"
                    type="object"
                    class="btn-danger"
                    confirm="Are you sure you want to refuse this order? It will be returned to Draft."
                    invisible="approval_state != 'pending' or not is_approver"/>
            </xpath>

            <!-- ── Status banners ──────────────────────────────────── -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 text-center"
                     role="alert"
                     invisible="approval_state != 'pending'">
                    <strong>⏳ Pending Approval</strong> — This order is waiting for
                    <field name="approver_id" readonly="1" nolabel="1" class="fw-bold d-inline-block"/> to approve it.
                </div>
                <div class="alert alert-danger mb-0 text-center"
                     role="alert"
                     invisible="approval_state != 'refused'">
                    <strong>❌ Approval Refused</strong> — This order was refused by
                    <field name="approved_by" readonly="1" nolabel="1" class="fw-bold d-inline-block"/>.
                    Please revise it and resubmit.
                </div>
            </xpath>

            <!-- ── Approver field in the main header group ────────────
                 Placed in the right-hand "order_details" group so it
                 is immediately visible when creating a quotation.
            ──────────────────────────────────────────────────────── -->
            <xpath expr="//group[@name='order_details']" position="inside">
                <field
                    name="approver_id"
                    widget="many2one_avatar_user"
                    readonly="state not in ('draft', 'sent')"
                    invisible="not require_approval"
                    placeholder="Select an approver…"
                    required="require_approval and state in ('draft', 'sent')"/>
            </xpath>

            <!-- ── Approval info tab ──────────────────────────────── -->
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Approval" name="approval_info"
                      invisible="not require_approval">
                    <group>
                        <group string="Approval Status">
                            <field name="approver_id" readonly="1" widget="many2one_avatar_user"/>
                            <field name="approval_state" readonly="1"/>
                            <field name="approved_by" readonly="1" widget="many2one_avatar_user"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                        <group string="Note">
                            <field name="approval_note"
                                   nolabel="1"
                                   readonly="state == 'sale'"
                                   placeholder="Optional note from the approver…"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         List view: add approval_state column
    ============================================================ -->
    <record id="view_sale_order_tree_approval" model="ir.ui.view">
        <field name="name">sale.order.list.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="approval_state"
                       widget="badge"
                       decoration-warning="approval_state == 'pending'"
                       decoration-danger="approval_state == 'refused'"
                       decoration-success="approval_state == 'approved'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Search view: add approval state filters
    ============================================================ -->
    <record id="view_sale_order_search_approval" model="ir.ui.view">
        <field name="name">sale.order.search.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter
                    string="Pending Approval"
                    name="pending_approval"
                    domain="[('approval_state', '=', 'pending')]"/>
                <filter
                    string="Approved"
                    name="approved"
                    domain="[('approval_state', '=', 'approved')]"/>
                <filter
                    string="Refused"
                    name="refused"
                    domain="[('approval_state', '=', 'refused')]"/>
            </xpath>
        </field>
    </record>

</odoo>
